{
  "expo": {
    "name": "CampusBITE",
    "slug": "campusbite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/CampusBITE_Logo.png",
    "scheme": "campusbite",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/CampusBITE_Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF9"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/CampusBITE_Logo.png",
        "backgroundColor": "#FAFAF9"
      },
      "package": "com.campusbite.app",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
