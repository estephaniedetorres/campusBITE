{
  "name": "campusbite",
  "version": "1.0.0",
  "private": true,
  "description": "CampusBITE - Offline-first canteen ordering on a phone hotspot (Expo app + API on the PC)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=mobile-server",
    "demo": "npm run demo --workspace=mobile-server",
    "serve": "npm run serve --workspace=mobile-server",
    "seed": "npm run seed --workspace=mobile-server",
    "reset-admin": "npm run reset-admin --workspace=mobile-server --",
    "test": "npm run test --workspace=mobile-server"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "expo": true,
    "expo-router": true,
    "react-native-web": true,
    "react-native-svg": true,
    "expo-status-bar": true,
    "qrcode": true,
    "query-string": true
  }
}
